# Project Kerberos Environment Configuration
# Strict Note: Do not commit this file to version control.

# Supabase Signaling Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Encryption Keys (Must be provisioned securely, never hardcoded in production)
HIVE_ENCRYPTION_KEY_BASE64=MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=

# Security & Identity
ED25519_PRIVATE_KEY=your_ed25519_private_key
DEVICE_UUID=unique_device_identifier

# C2PA Signing Configurations
C2PA_CERTIFICATE_PATH=assets/certs/c2pa_cert.pem
C2PA_PRIVATE_KEY_PATH=assets/certs/c2pa_private.key
C2PA_TA_URL=https://time.apple.com
